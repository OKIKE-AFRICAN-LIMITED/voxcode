<section id="install" class="section install-sec">
  <div class="wrap">
    <div class="install-box">
      <div>
        <div class="eyebrow">Ready to Ship</div>
        <h2>Install VoxCode in 30 seconds</h2>
        <p>Package: <code>agent-voice-bridge-0.1.0.vsix</code> (26.3 KB)</p>
      </div>
      <div class="install-right">
        <div class="cli-box">
          <code id="cliCmd">code --install-extension agent-voice-bridge-0.1.0.vsix</code>
          <button id="copyCliBtn" type="button">Copy</button>
        </div>
        <span class="ui-hint">Or in IDE: Extensions (<code>Ctrl+Shift+X</code>) → <code>...</code> → Install from VSIX...</span>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copyCliBtn');
  const cliCmd = document.getElementById('cliCmd');
  copyBtn?.addEventListener('click', async () => {
    const text = cliCmd?.textContent || '';
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.textContent = 'Copied';
      setTimeout(() => {
        copyBtn.textContent = 'Copy';
      }, 1500);
    } catch {
      copyBtn.textContent = 'Copy';
    }
  });
</script>

