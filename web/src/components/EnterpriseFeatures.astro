<section id="architecture" class="section">
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow">Architecture</div>
      <h2>Built for real engineering teams.</h2>
      <p>Every layer is designed to eliminate Electron mic blocks, preserve technical jargon, and scale from solo devs to enterprise rollouts.</p>
    </div>

    <div class="bento">
      <!-- Wide card: Signal Flow -->
      <div class="bento-card span-2">
        <div class="bento-meta">01 · NATIVE CAPTURE PIPELINE</div>
        <h3>Zero-permission Windows audio capture</h3>
        <p>Bypasses VS Code Webview <code>Permission denied</code> errors by recording 16 kHz mono WAV natively through Windows <code>winmm.dll</code>—with zero external binaries.</p>
        <div class="flow-diagram">
          <div class="node"><span>Alt+Space</span><strong>Mic 16 kHz</strong></div>
          <div class="wire"></div>
          <div class="node accent"><span>AI Engine</span><strong>Gemini / Whisper</strong></div>
          <div class="wire"></div>
          <div class="node"><span>Auto-Focus</span><strong>Agent Chat</strong></div>
        </div>
      </div>

      <!-- IDE Tiles -->
      <div class="bento-card">
        <div class="bento-meta">02 · UNIVERSAL BRIDGE</div>
        <h3>One .vsix, four IDEs</h3>
        <p>Detects the active host command automatically.</p>
        <div class="ide-grid">
          <div class="ide-tile">Antigravity</div>
          <div class="ide-tile">VS Code</div>
          <div class="ide-tile">Cursor</div>
          <div class="ide-tile">Windsurf</div>
        </div>
      </div>

      <!-- Vocabulary -->
      <div class="bento-card">
        <div class="bento-meta">03 · DOMAIN PRECISION</div>
        <h3>Custom technical vocabulary</h3>
        <p>Feed project symbols, tickers, and frameworks so AI never mangles terms like <code>XAUUSDm</code>, <code>MQL5</code>, or <code>walk-forward</code>.</p>
        <div class="token-cloud">
          <span>XAUUSDm</span><span>MQL5</span><span>ATR</span><span>OpenRouter</span><span>VPC</span>
        </div>
      </div>

      <!-- Zero Secrets & Phase 2 -->
      <div class="bento-card span-2">
        <div class="bento-meta">04 · ENTERPRISE SECURITY &amp; ROADMAP</div>
        <h3>Zero embedded secrets. Ready for Phase 2 two-way voice.</h3>
        <p>No API keys are ever packaged inside the <code>.vsix</code>. Resolve keys via Settings, environment variables, private VPC proxies, or upcoming local on-device Whisper—with Phase 2 adding VAD auto-send and concise TTS agent replies.</p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.bento-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const ev = e as MouseEvent;
      const rect = (card as HTMLElement).getBoundingClientRect();
      (card as HTMLElement).style.setProperty('--mx', `${ev.clientX - rect.left}px`);
      (card as HTMLElement).style.setProperty('--my', `${ev.clientY - rect.top}px`);
    });
  });
</script>

