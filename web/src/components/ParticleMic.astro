<div class="particle-stage" id="particleStage">
  <canvas id="micWebGL" aria-label="Interactive 3D Golden Particle Microphone"></canvas>
</div>

<script>
  import * as THREE from 'three';

  const stage = document.getElementById('particleStage');
  const canvas = document.getElementById('micWebGL') as HTMLCanvasElement | null;

  if (stage && canvas) {
    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: 'high-performance'
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    camera.position.set(0, 0.1, 6.4);

    // Build organic 3D studio microphone surface points
    function generateStudioMic(countCapsule: number) {
      const positions: number[] = [];
      const sizes: number[] = [];
      const seeds: number[] = [];
      const rimFactors: number[] = [];

      const R = 0.62;
      const halfH = 0.56;
      const centerY = 0.42;

      // 1. Fibonacci-distributed capsule (top hemisphere + cylinder + bottom hemisphere)
      const goldenAngle = Math.PI * (3 - Math.sqrt(5));
      for (let i = 0; i < countCapsule; i++) {
        const t = (i + 0.5) / countCapsule;
        const yTotal = (1 - 2 * t) * (halfH + R);
        let r = R;
        if (yTotal > halfH) {
          const dy = yTotal - halfH;
          r = Math.sqrt(Math.max(0, R * R - dy * dy));
        } else if (yTotal < -halfH) {
          const dy = -halfH - yTotal;
          r = Math.sqrt(Math.max(0, R * R - dy * dy));
        }
        const theta = goldenAngle * i;
        const x = Math.cos(theta) * r;
        const z = Math.sin(theta) * r;
        positions.push(x, centerY + yTotal, z);
        sizes.push(2.8 + Math.random() * 1.4);
        seeds.push(Math.random() * 100);
        rimFactors.push(1.0);
      }

      // 2. 3D U-shaped Cradle (smooth 3D tube)
      const cradleR = 0.96;
      const cradleY = centerY - 0.52;
      const tubeR = 0.055;
      const arcSteps = 72;
      const ringPts = 8;
      for (let i = 0; i <= arcSteps; i++) {
        const a = Math.PI * (0.04 + (i / arcSteps) * 0.92);
        const cx = Math.cos(a) * cradleR;
        const cy = cradleY - Math.sin(a) * cradleR;
        const nx = Math.cos(a);
        const ny = -Math.sin(a);
        for (let j = 0; j < ringPts; j++) {
          const phi = (j / ringPts) * Math.PI * 2 + i * 0.3;
          const px = cx + nx * Math.cos(phi) * tubeR;
          const py = cy + ny * Math.cos(phi) * tubeR;
          const pz = Math.sin(phi) * tubeR;
          positions.push(px, py, pz);
          sizes.push(2.5 + Math.random() * 1.1);
          seeds.push(Math.random() * 100);
          rimFactors.push(0.95);
        }
      }

      // 3. Side mount pins
      for (const side of [-1, 1]) {
        for (let s = 0; s < 5; s++) {
          const x = side * (R + 0.05 + (s / 4) * (cradleR - R - 0.06));
          for (let j = 0; j < 6; j++) {
            const phi = (j / 6) * Math.PI * 2;
            positions.push(x, cradleY + Math.cos(phi) * 0.04, Math.sin(phi) * 0.04);
            sizes.push(2.4);
            seeds.push(Math.random() * 100);
            rimFactors.push(0.9);
          }
        }
      }

      // 4. Cylindrical Stem
      const stemTop = cradleY - cradleR;
      const stemBottom = stemTop - 0.62;
      for (let i = 0; i <= 12; i++) {
        const y = stemTop - (i / 12) * 0.62;
        for (let j = 0; j < 10; j++) {
          const phi = (j / 10) * Math.PI * 2 + i * 0.25;
          positions.push(Math.cos(phi) * 0.07, y, Math.sin(phi) * 0.07);
          sizes.push(2.5);
          seeds.push(Math.random() * 100);
          rimFactors.push(0.9);
        }
      }

      // 5. 3D Circular Studio Base (concentric volumetric disc)
      const baseR = 0.72;
      for (let i = 0; i < 240; i++) {
        const t = (i + 0.5) / 240;
        const r = Math.sqrt(t) * baseR;
        const theta = goldenAngle * i;
        const y = stemBottom - (1 - t) * 0.04;
        positions.push(Math.cos(theta) * r, y, Math.sin(theta) * r);
        sizes.push(2.6 + (r / baseR) * 1.1);
        seeds.push(Math.random() * 100);
        rimFactors.push(0.85 + (r / baseR) * 0.25);
      }

      // 6. Floating 3D Golden Stardust around the mic
      for (let i = 0; i < 160; i++) {
        const rad = 1.3 + Math.random() * 1.9;
        const theta = Math.random() * Math.PI * 2;
        const y = (Math.random() - 0.5) * 3.4;
        positions.push(Math.cos(theta) * rad, y, Math.sin(theta) * rad);
        sizes.push(1.4 + Math.random() * 1.8);
        seeds.push(Math.random() * 100);
        rimFactors.push(0.45);
      }

      return { positions, sizes, seeds, rimFactors };
    }

    const { positions, sizes, seeds, rimFactors } = generateStudioMic(1150);
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    geometry.setAttribute('aSize', new THREE.Float32BufferAttribute(sizes, 1));
    geometry.setAttribute('aSeed', new THREE.Float32BufferAttribute(seeds, 1));
    geometry.setAttribute('aRim', new THREE.Float32BufferAttribute(rimFactors, 1));

    const uniforms = {
      uTime: { value: 0 },
      uPulse: { value: 0 },
      uMouse: { value: new THREE.Vector3(99, 99, 99) },
      uMouseActive: { value: 0 },
      uPixelRatio: { value: Math.min(window.devicePixelRatio || 1, 2) }
    };

    const material = new THREE.ShaderMaterial({
      uniforms,
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexShader: `
        attribute float aSize;
        attribute float aSeed;
        attribute float aRim;
        uniform float uTime;
        uniform float uPulse;
        uniform vec3 uMouse;
        uniform float uMouseActive;
        uniform float uPixelRatio;
        varying float vAlpha;
        varying float vHeat;

        void main() {
          vec3 pos = position;

          // Gentle organic breathing float
          float wave = sin(uTime * 1.6 + aSeed) * 0.018;
          pos.y += wave;

          // Acoustic voice pulse ripple
          float distOrigin = length(pos);
          float pulseWave = sin(uTime * 7.5 - distOrigin * 4.5) * 0.08 * uPulse;
          pos += normalize(pos + vec3(0.0001)) * pulseWave;

          // Interactive 3D mouse repulsion + swirl
          if (uMouseActive > 0.01) {
            vec3 toParticle = pos - uMouse;
            float d = length(toParticle);
            float radius = 0.95;
            if (d < radius && d > 0.001) {
              float strength = (1.0 - d / radius);
              strength = strength * strength * uMouseActive;
              vec3 pushDir = normalize(toParticle);
              vec3 swirl = vec3(-pushDir.z, pushDir.y * 0.3, pushDir.x);
              pos += pushDir * strength * 0.55 + swirl * strength * 0.25;
            }
          }

          vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
          gl_Position = projectionMatrix * mvPosition;

          // Perspective-scaled particle size
          gl_PointSize = aSize * uPixelRatio * (18.0 / max(1.5, -mvPosition.z));

          // Depth + rim lighting
          float depthFade = clamp((-mvPosition.z - 4.2) / 3.8, 0.0, 1.0);
          vAlpha = mix(1.0, 0.35, depthFade) * aRim;
          vHeat = clamp(1.0 - depthFade * 0.7 + uPulse * 0.3, 0.0, 1.0);
        }
      `,
      fragmentShader: `
        varying float vAlpha;
        varying float vHeat;

        void main() {
          vec2 uv = gl_PointCoord - vec2(0.5);
          float d = length(uv);
          if (d > 0.5) discard;

          // Crisp glowing golden core + smooth radial bloom
          float core = smoothstep(0.24, 0.0, d);
          float halo = exp(-d * 6.5) * 0.85;
          float intensity = core + halo;

          // Pure 24k Gold palette only
          vec3 deepGold = vec3(0.85, 0.47, 0.02);   // #d97706
          vec3 pureGold = vec3(0.98, 0.75, 0.14);   // #fbbf24
          vec3 brightGold = vec3(1.0, 0.92, 0.62);  // #ffeb9e

          vec3 col = mix(deepGold, pureGold, vHeat);
          col = mix(col, brightGold, core * 0.75);

          gl_FragColor = vec4(col, intensity * vAlpha * 0.95);
        }
      `
    });

    const micPoints = new THREE.Points(geometry, material);
    scene.add(micPoints);

    // Mouse / Touch tracking in 3D space
    const raycaster = new THREE.Raycaster();
    const pointer = new THREE.Vector2();
    const hitPlane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    const hitPoint = new THREE.Vector3();

    let targetTiltX = 0;
    let targetTiltY = 0;
    let targetMouseActive = 0;
    let targetPulse = 0;

    function updatePointer(clientX: number, clientY: number) {
      const rect = canvas!.getBoundingClientRect();
      pointer.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      pointer.y = -((clientY - rect.top) / rect.height) * 2 + 1;

      targetTiltY = pointer.x * 0.38;
      targetTiltX = -pointer.y * 0.22;
      targetMouseActive = 1.0;

      raycaster.setFromCamera(pointer, camera);
      if (raycaster.ray.intersectPlane(hitPlane, hitPoint)) {
        micPoints.worldToLocal(hitPoint);
        uniforms.uMouse.value.copy(hitPoint);
      }
    }

    canvas.addEventListener('mousemove', (e) => updatePointer(e.clientX, e.clientY));
    canvas.addEventListener('mouseleave', () => {
      targetMouseActive = 0.0;
      targetTiltX = 0;
      targetTiltY = 0;
    });

    canvas.addEventListener('touchmove', (e) => {
      if (e.touches[0]) updatePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });
    canvas.addEventListener('touchend', () => {
      targetMouseActive = 0.0;
    });

    canvas.addEventListener('click', () => {
      targetPulse = targetPulse > 0.5 ? 0.0 : 1.0;
    });

    window.addEventListener('voxcode:pulse', () => {
      targetPulse = 1.0;
      setTimeout(() => {
        targetPulse = 0.0;
      }, 2200);
    });

    function handleResize() {
      if (!stage || !canvas) return;
      const w = stage.clientWidth || 540;
      const h = stage.clientHeight || 480;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h, false);
      const pr = Math.min(window.devicePixelRatio || 1, 2);
      renderer.setPixelRatio(pr);
      uniforms.uPixelRatio.value = pr;
    }

    const ro = new ResizeObserver(handleResize);
    ro.observe(stage);
    handleResize();

    const clock = new THREE.Clock();
    function renderLoop() {
      const elapsed = clock.getElapsedTime();
      uniforms.uTime.value = elapsed;
      uniforms.uMouseActive.value += (targetMouseActive - uniforms.uMouseActive.value) * 0.08;
      uniforms.uPulse.value += (targetPulse - uniforms.uPulse.value) * 0.08;

      // Smooth continuous 3D rotation + interactive cursor tilt
      const autoRotY = elapsed * 0.35;
      micPoints.rotation.y += (autoRotY + targetTiltY - micPoints.rotation.y) * 0.06;
      micPoints.rotation.x += (0.12 + targetTiltX - micPoints.rotation.x) * 0.06;

      renderer.render(scene, camera);
      requestAnimationFrame(renderLoop);
    }
    renderLoop();
  }
</script>

<style>
  .particle-stage {
    position: relative;
    width: 100%;
    height: 490px;
    background: radial-gradient(circle at 50% 48%, rgba(251, 191, 36, 0.12) 0%, rgba(245, 158, 11, 0.03) 38%, transparent 68%);
    overflow: visible;
  }
  #micWebGL {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  #micWebGL:active {
    cursor: grabbing;
  }
  @media (max-width: 720px) {
    .particle-stage {
      height: 370px;
    }
  }
</style>
